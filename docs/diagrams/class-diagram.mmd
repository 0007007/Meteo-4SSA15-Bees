    style Sensor fill:#E3EDF9,stroke:#336791,stroke-width:1.5px
    style Observation fill:#E6F4EA,stroke:#2E7D32,stroke-width:1.5px
    style AirQuality fill:#E6F4EA,stroke:#2E7D32,stroke-width:1.5px
    style ForecastModel fill:#E6F4EA,stroke:#2E7D32,stroke-width:1.5px
    style Forecast fill:#E6F4EA,stroke:#2E7D32,stroke-width:1.5px
    style Alert fill:#FDF0E1,stroke:#C26A00,stroke-width:1.5px
    style Notification fill:#FDF0E1,stroke:#C26A00,stroke-width:1.5px
    style User fill:#FDF0E1,stroke:#C26A00,stroke-width:1.5px
    style FavoriteLocation fill:#FDF0E1,stroke:#C26A00,stroke-width:1.5px
